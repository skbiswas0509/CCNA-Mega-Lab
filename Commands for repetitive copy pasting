*****R1, Access Switches *******
enable secret jeremysitlab
username cisco secret ccna
line console 0
login local
exec-timeout 30
logging synchronous


*****Core, Distribution switches*****
enable algorithm-type scrypt secret jeremysitlab
username cisco algorithm-type scrypt secret ccna
line console 0
login local
exec-timeout 30
logging synchronous


******Part 2, Step 3*****
***DSW-A1, DSW-A2***
1. Configure uplinks to access switches
interface range g1/0/1-3
 switchport mode trunk
 switchport nonegotiate
 switchport trunk native vlan 1000
 switchport trunk allowed vlan 10,20,40,99
 exit

! 2. Configure EtherChannel trunk
interface port-channel 1
 switchport mode trunk
 switchport nonegotiate
 switchport trunk native vlan 1000
 switchport trunk allowed vlan 10,20,40,99
 exit

***ASW-A1,ASW-A2,ASW-A3***
! Configure uplinks to distribution switches (using ports g0/1 through g0/3)
interface range g0/1-2
 switchport mode trunk
 switchport nonegotiate
 switchport trunk native vlan 1000
 switchport trunk allowed vlan 10,20,40,99
 exit

***DSW-B1, DSW-B2***
1. Configure uplinks to access switches
interface range g1/0/1-3
 switchport mode trunk
 switchport nonegotiate
 switchport trunk native vlan 1000
 switchport trunk allowed vlan 10,20,30,99
 exit

! 2. Configure EtherChannel trunk
interface port-channel 1
 switchport mode trunk
 switchport nonegotiate
 switchport trunk native vlan 1000
 switchport trunk allowed vlan 10,20,30,99
 exit


***ASW-A1,ASW-A2,ASW-A3***
! Configure uplinks to distribution switches (using ports g0/1 through g0/3)
interface range g0/1-2
 switchport mode trunk
 switchport nonegotiate
 switchport trunk native vlan 1000
 switchport trunk allowed vlan 10,20,30,99
 exit


******Part 2, Step 3*****
***ASW-A2,ASW-A3,ASW-B2***
interface f0/1
 switchport mode access
 switchport nonegotiate
 switchport access vlan 10
 switchport voice vlan 20
 exit

******Part 2, Step 9*****
***DSW-A1,DSW-A2,DSW-B1,DSW-B2***
interface range g1/0/6-24,g1/1/3-4
shutdown


***ASW-A2,ASW-A3,ASW-B1,ASW-B2,ASW-B3***
interface range f0/2-24
shutdown
 